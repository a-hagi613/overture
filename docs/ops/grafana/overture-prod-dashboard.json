{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Overture production observability for Fly.io's built-in Grafana (fly-metrics.net). Six rows: Runtime & Catalog, API Latency, Apply & ATS Health, LLM & Tagging, Queue/Mail/Billing and Fly System Resources. Import it, pick the Prometheus datasource that scrapes the app's private :9091 metrics, and the fly_instance_* series for the last row.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
          "id": 101,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "histogram_quantile(0.95, sum by (le) (rate(overture_event_loop_lag_ms_bucket[$__rate_interval])))",
              "legendFormat": "p95 event-loop lag",
              "refId": "A"
            }
          ],
          "title": "Event-loop lag p95",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "short" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
          "id": 102,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum(increase(overture_catalog_postings_total[$__rate_interval]))",
              "legendFormat": "postings applied",
              "refId": "A"
            }
          ],
          "title": "Catalog postings applied",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
          "id": 103,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "histogram_quantile(0.95, sum by (le) (rate(overture_catalog_swap_duration_ms_bucket[$__rate_interval])))",
              "legendFormat": "p95 swap duration",
              "refId": "A"
            },
            {
              "editorMode": "code",
              "expr": "sum(increase(overture_catalog_swap_failures_total[$__rate_interval]))",
              "legendFormat": "swap failures",
              "refId": "B"
            }
          ],
          "title": "Catalog swap duration & failures",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "bytes" },
            "overrides": []
          },
          "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
          "id": 104,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "avg(rate(overture_catalog_swap_bytes_sum[$__rate_interval]))",
              "legendFormat": "mean snapshot bytes / s",
              "refId": "A"
            }
          ],
          "title": "Catalog snapshot bytes",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": []
          },
          "gridPos": { "h": 7, "w": 16, "x": 8, "y": 9 },
          "id": 105,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "histogram_quantile(0.95, sum by (le, db, op) (rate(overture_sqlite_query_duration_ms_bucket[$__rate_interval])))",
              "legendFormat": "{{db}} {{op}} p95",
              "refId": "A"
            }
          ],
          "title": "SQLite query duration p95",
          "type": "timeseries"
        }
      ],
      "title": "Runtime & Catalog",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 200,
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "reqps" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
          "id": 201,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum by (route, method, status_class) (rate(overture_http_requests_total[$__rate_interval]))",
              "legendFormat": "{{method}} {{route}} {{status_class}}",
              "refId": "A"
            }
          ],
          "title": "HTTP requests by route",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
          "id": 202,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "histogram_quantile(0.95, sum by (le, route) (rate(overture_http_duration_ms_bucket[$__rate_interval])))",
              "legendFormat": "{{route}} p95",
              "refId": "A"
            }
          ],
          "title": "HTTP duration p95 by route",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": []
          },
          "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
          "id": 203,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "histogram_quantile(0.95, sum by (le) (rate(overture_supply_query_duration_ms_bucket[$__rate_interval])))",
              "legendFormat": "supply query p95",
              "refId": "A"
            }
          ],
          "title": "Public supply query p95",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "percentunit" },
            "overrides": []
          },
          "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
          "id": 204,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum(rate(overture_http_requests_total{status_class=~\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(overture_http_requests_total[$__rate_interval])), 0.000001)",
              "legendFormat": "5xx share",
              "refId": "A"
            }
          ],
          "title": "5xx share",
          "type": "timeseries"
        }
      ],
      "title": "API Latency",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 300,
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ops" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
          "id": 301,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum by (ats, mode, outcome) (rate(overture_apply_runs_total[$__rate_interval]))",
              "legendFormat": "{{ats}} {{mode}} {{outcome}}",
              "refId": "A"
            }
          ],
          "title": "Apply runs by ATS, mode and outcome",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
          "id": 302,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "histogram_quantile(0.95, sum by (le, ats, outcome) (rate(overture_apply_duration_ms_bucket[$__rate_interval])))",
              "legendFormat": "{{ats}} {{outcome}} p95",
              "refId": "A"
            }
          ],
          "title": "Apply duration p95",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ops" },
            "overrides": []
          },
          "gridPos": { "h": 7, "w": 24, "x": 0, "y": 41 },
          "id": 303,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum by (ats, outcome) (rate(overture_form_self_heal_total[$__rate_interval]))",
              "legendFormat": "{{ats}} {{outcome}}",
              "refId": "A"
            }
          ],
          "title": "Form self-heal by ATS",
          "type": "timeseries"
        }
      ],
      "title": "Apply & ATS Health",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 400,
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "reqps" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
          "id": 401,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum by (purpose, model, status) (rate(overture_llm_requests_total[$__rate_interval]))",
              "legendFormat": "{{purpose}} {{model}} {{status}}",
              "refId": "A"
            }
          ],
          "title": "LLM requests",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "short" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
          "id": 402,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum by (purpose, direction) (rate(overture_llm_tokens_total[$__rate_interval]))",
              "legendFormat": "{{purpose}} {{direction}}",
              "refId": "A"
            }
          ],
          "title": "LLM tokens",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "currencyUSD" },
            "overrides": []
          },
          "gridPos": { "h": 7, "w": 12, "x": 0, "y": 57 },
          "id": 403,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum by (purpose) (rate(overture_llm_cost_usd_total[$__rate_interval])) * 3600",
              "legendFormat": "{{purpose}} USD / h",
              "refId": "A"
            }
          ],
          "title": "LLM cost per hour",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "max": 1, "min": 0, "unit": "percentunit" },
            "overrides": []
          },
          "gridPos": { "h": 7, "w": 12, "x": 12, "y": 57 },
          "id": 404,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "max by (tier) (overture_tag_coverage_ratio)",
              "legendFormat": "{{tier}}",
              "refId": "A"
            }
          ],
          "title": "Role tag coverage by tier",
          "type": "timeseries"
        }
      ],
      "title": "LLM & Tagging",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 64 },
      "id": 500,
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "short" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 65 },
          "id": 501,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum by (kind) (overture_bg_queue_depth)",
              "legendFormat": "{{kind}}",
              "refId": "A"
            }
          ],
          "title": "Background queue depth",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ms" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 65 },
          "id": 502,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "histogram_quantile(0.95, sum by (le, kind, status) (rate(overture_bg_job_duration_ms_bucket[$__rate_interval])))",
              "legendFormat": "{{kind}} {{status}} p95",
              "refId": "A"
            }
          ],
          "title": "Job duration p95",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "ops" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 65 },
          "id": 503,
          "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "sum by (direction, status) (rate(overture_mail_events_total[$__rate_interval]))",
              "legendFormat": "{{direction}} {{status}}",
              "refId": "A"
            },
            {
              "editorMode": "code",
              "expr": "sum by (event, plan) (rate(overture_billing_events_total[$__rate_interval]))",
              "legendFormat": "{{event}} {{plan}}",
              "refId": "B"
            }
          ],
          "title": "Mail & billing events",
          "type": "timeseries"
        }
      ],
      "title": "Queue, Mail & Billing",
      "type": "row"
    },
    {
      "collapsed": false,
      "description": "Fly's own node-exporter-compatible fly_instance_* series. Enable the built-in Prometheus metrics for the app in fly.toml ([metrics]) and select the same datasource.",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 72 },
      "id": 600,
      "panels": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "max": 1, "min": 0, "unit": "percentunit" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 73 },
          "id": 601,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "1 - (fly_instance_memory_mem_available / fly_instance_memory_mem_total)",
              "legendFormat": "RAM used",
              "refId": "A"
            }
          ],
          "title": "Fly memory used",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "max": 1, "min": 0, "unit": "percentunit" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 8, "y": 73 },
          "id": 602,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "1 - (fly_instance_filesystem_avail_bytes / fly_instance_filesystem_size_bytes)",
              "legendFormat": "NVMe used",
              "refId": "A"
            }
          ],
          "title": "Fly NVMe used",
          "type": "timeseries"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "fieldConfig": {
            "defaults": { "unit": "percent" },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 16, "y": 73 },
          "id": 603,
          "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
          "targets": [
            {
              "editorMode": "code",
              "expr": "avg(fly_instance_cpu) * 100",
              "legendFormat": "CPU",
              "refId": "A"
            },
            {
              "editorMode": "code",
              "expr": "sum(rate(fly_instance_network_receive_bytes[$__rate_interval]))",
              "legendFormat": "network in B/s",
              "refId": "B"
            }
          ],
          "title": "Fly CPU & network",
          "type": "timeseries"
        }
      ],
      "title": "Fly System Resources",
      "type": "row"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
