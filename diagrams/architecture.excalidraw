      "isDeleted": false,
      "boundElements": [],
      "updated": 1795279568597,
      "link": null,
      "locked": false,
      "text": "Unknown required question pauses only affected apps (`needs_review`).\nAnswering once saves a Tier 3 Fact (`q:<id>`) & re-prepares all N unlocked apps.\nAlso surfaces in Profile -> Strengthen your profile (Tier 2 Facts).",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
