# Local development sample. Copy to .env (chmod 600, never committed) and fill in real values.
# Production reads Fly secrets instead; docs/DEPLOY.md lists which ones the deploy gate requires.

NODE_ENV=development
PORT=3000
DATABASE_URL=data/overture.db

BETTER_AUTH_SECRET=replace-with-at-least-16-random-characters
OWNER_EMAIL=owner@example.com

APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=https://admin.tryoverture.com
MAIL_DOMAIN=tryoverture.com
MAIL_FROM=no-reply@tryoverture.com

# Cloudflare Turnstile. Cloudflare's always-pass test keys work locally (test/e2e/auth.fixture.ts).
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET=replace-with-turnstile-secret
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Synthetic lab (issue #36). All optional: the script and verify URLs default to the vendors' and the lab runs only
# when LAB_BASE_URL (or APP_ORIGIN) names the origin that serves /lab/*. Tests point these at same-origin stubs.
# LAB_BASE_URL=https://tryoverture.com
# LAB_RECAPTCHA_SITE_KEY=
# LAB_RECAPTCHA_SECRET=
# LAB_HCAPTCHA_SITE_KEY=
# LAB_TURNSTILE_SITE_KEY=

# Envelope encryption: `openssl rand -base64 32`. Never rotate without the re-wrap step.
MASTER_KEY_V1=replace-with-base64-that-decodes-to-32-bytes
MASTER_KEY_CURRENT=1

# OAuth pairs are optional; set both or neither.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Cloudflare Email Sending for Overture's own mail. Both or neither; with neither the in-memory sink is used.
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_EMAIL_API_BASE_URL=https://api.cloudflare.com/client/v4
# REQUIRE_EMAIL_SENDING=false

# Stripe Managed Payments (M3). Both secrets or neither; with neither billing is off and the app runs as in M2.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE_URL=https://api.stripe.com
# STRIPE_PRICE_WEEK=
# STRIPE_PRICE_MONTH=

# Inbound mail Worker requests and replies.
# INBOUND_HMAC_SECRET=

# R2 for backups and encrypted files; tests use the disk object store instead.
OBJECT_STORE_ROOT=data/objects
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_FILES=
# R2_BUCKET_BACKUPS=

# Browser providers. Local Chrome is the development and test path.
BROWSER_PROVIDER=local
# BROWSER_USE_API_KEY=
# KERNEL_API_KEY=

# LLM.
# ANTHROPIC_API_KEY=

# Optional notifications and telemetry.
# ALERT_NTFY_URL=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# Admin audit ships to Grafana Loki when LOKI_URL is set; unset keeps it on the machine only.
# LOKI_URL=
# LOKI_AUTH_TOKEN=
# LOKI_TENANT_ID=
# LOKI_SERVICE_NAME=overture
# LOKI_AUDIT_JOB=overture-admin-audit

# Litestream and Fly run themselves in production; leave these unset locally.
# FLY_APP_NAME=
# FLY_MACHINE_ID=
