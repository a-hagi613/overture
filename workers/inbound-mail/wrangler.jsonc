{
  "name": "overture-inbound-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
  },
  "vars": {
    "OVERTURE_ORIGIN": "https://tryoverture.com",
  },
  "queues": {
    "producers": [
      {
        "binding": "INBOUND_QUEUE",
        "queue": "overture-inbound-mail",
      },
    ],
    "consumers": [
      {
        "queue": "overture-inbound-mail",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "retry_delay": 300,
        "dead_letter_queue": "overture-inbound-mail-dlq",
      },
      {
        "queue": "overture-inbound-mail-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100,
        "retry_delay": 300,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "INBOUND_SPILL",
      "bucket_name": "overture-inbound-mail-spill",
    },
  ],
}
