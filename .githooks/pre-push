#!/bin/sh
set -eu

saw_ref=0
has_non_delete=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  saw_ref=1
  case "$local_sha" in
    *[!0]*) has_non_delete=1 ;;
  esac
done

if [ "$saw_ref" -eq 1 ] && [ "$has_non_delete" -eq 0 ]; then
  exit 0
fi

if bun scripts/stamp.ts check >/dev/null 2>&1; then
  printf 'pre-push: verify stamp valid for HEAD + tree, skipping duplicate run\n'
  exit 0
fi

bun run verify
