{
  "name": "overture",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build && bun run scripts/prerender.tsx",
    "build:checked": "bun run build && bun run copy:check:dist",
    "copy:check:dist": "bun run scripts/check-copy-dist.ts",
    "start": "bun run src/server/main.ts",
    "typecheck": "bun check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:config": "bun run scripts/check-lint-config.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test:unit": "bun test src scripts",
    "test:e2e": "bun node_modules/playwright/cli.js test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/server/platform/db/migrate.ts",
    "db:template": "bun run scripts/create-template-db.ts test/e2e/.tmp/template.db",
    "db:backfill-mailboxes": "bun run scripts/backfill-mailboxes.ts",
    "db:seed-demo": "bun run scripts/seed-demo.ts",
    "db:verify": "bun run scripts/verify-db.ts",
    "lint:parity": "bun run scripts/lint-parity.ts",
    "verify": "bun run scripts/verify.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.26",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@tanstack/react-query": "^5.108.1",
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "htmlparser2": "10.1.0",
    "hyparquet": "^1.33.1",
    "jose": "^6.2.18",
    "lucide-react": "^1.76.0",
    "mailauth": "^8.1.0",
    "mailparser": "^3.15.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@interfere/landmines": "^0.1.1",
    "@oxlint/plugins": "^1.94.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "engines": {
    "bun": "1.4.5"
  }
}
