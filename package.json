{
  "name": "overture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun run src/server/main.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:config": "bun run scripts/check-lint-config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/server/platform/db/migrate.ts",
    "db:template": "bun run scripts/create-template-db.ts test/e2e/.tmp/template.db",
    "db:verify": "bun run scripts/verify-db.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.108.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@interfere/landmines": "^0.1.1",
    "@oxlint/plugins": "^1.94.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "msw": "^2.15.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
