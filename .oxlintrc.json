{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "**/dist/**",
    "public/**",
    "**/node_modules/**",
    "**/CHANGELOG.md",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "import",
    "node",
    "promise",
    "oxc",
    "vitest",
    "jsdoc",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "jsPlugins": [
    {
      "name": "landmines-testing",
      "specifier": "@interfere/landmines/testing"
    },
    {
      "name": "landmines-style",
      "specifier": "@interfere/landmines/style"
    },
    {
      "name": "landmines-structure",
      "specifier": "@interfere/landmines/structure"
    },
    {
      "name": "landmines-types",
      "specifier": "@interfere/landmines/types"
    },
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "overture",
      "specifier": "./tools/oxlint/architecture/index.ts"
    }
  ],
  "env": {
    "builtin": true,
    "node": true,
    "browser": true,
    "bun": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "style": "error",
    "nursery": "off",
    "restriction": "error",
    "pedantic": "error"
  },
  "rules": {
    "landmines-testing/no-fixed-sleep": "error",
    "landmines-testing/no-flake-masking": "error",
    "landmines-testing/no-test-doubles": "error",
    "landmines-testing/no-unsignaled-poll": "error",
    "landmines-style/no-comments": [
      "error",
      {
        "allow": []
      }
    ],
    "landmines-structure/colocated-tests": "error",
    "landmines-structure/package-exports": "error",
    "landmines-structure/test-file-names": "error",
    "landmines-types/no-explicit-return-types": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "overture/no-disable-directives": "error",
    "overture/no-date-now": [
      "error",
      {
        "allow": ["src/server/platform/ports/clock.ts"]
      }
    ],
    "overture/no-main-thread-catalog-writes": [
      "error",
      {
        "allow": [
          "src/server/catalog/sweep-worker.ts",
          "src/server/catalog/sweep-run.ts",
          "src/server/catalog/poll-board.ts",
          "src/server/catalog/workable-ingest.ts",
          "src/server/catalog/tag-store.ts",
          "src/server/catalog/feed-retag.ts",
          "src/server/catalog/discovered-boards.ts",
          "src/server/catalog/tag-import.ts",
          "src/server/platform/jobs/retention.ts",
          "src/server/routes/test-only.ts",
          "src/server/pipeline/prepare.ts",
          "src/server/dispatch/dispatch.ts",
          "src/server/dispatch/outcomes.test.ts",
          "src/server/demo/seed.ts",
          "src/server/billing/pause.test.ts",
          "src/server/dispatch/report.test.ts",
          "src/server/platform/db/migration-snapshot.test.ts",
          "src/server/platform/db/catalog-split.test.ts",
          "src/server/platform/db/hot-path-indexes.test.ts",
          "src/server/platform/jobs/retention.test.ts",
          "src/server/matching/applications.test.ts",
          "src/server/inbox/linked-mail.test.ts",
          "src/server/inbox/threads.test.ts",
          "src/server/pipeline/approved-plan.test.ts",
          "src/server/pipeline/email-notes.test.ts",
          "src/server/pipeline/reviews.test.ts"
        ],
        "allowRoots": ["test/e2e", "scripts"]
      }
    ],
    "overture/no-math-random": [
      "error",
      {
        "allow": ["src/server/platform/ports/random.ts"]
      }
    ],
    "overture/no-raw-design-styles": [
      "error",
      {
        "allowBrandFiles": [
          "src/web/components/google-mark.tsx",
          "src/web/components/linkedin-mark.tsx",
          "src/web/components/landing/company-brands.tsx",
          "src/web/components/landing/company-brands-data.ts",
          "src/web/components/landing/ats-logos.tsx"
        ],
        "enforceStrictPaths": ["src/web/"]
      }
    ],
    "overture/no-unlisted-unit-test": [
      "error",
      {
        "e2eRoot": "test/e2e",
        "allow": [
          "scripts/check-admin-host.test.ts",
          "scripts/check-production.test.ts",
          "scripts/database-sync-guard.test.ts",
          "scripts/design-scale-guard.test.ts",
          "scripts/lint-config-guard.test.ts",
          "scripts/setup-stripe.test.ts",
          "scripts/vacuum-app-db.test.ts",
          "scripts/vacuum-fly.test.ts",
          "scripts/workflow-config-guard.test.ts",
          "src/server/account/erase.test.ts",
          "src/server/admin/key-rotation.test.ts",
          "src/server/admin/support.test.ts",
          "src/server/app.test.ts",
          "src/server/auth/client-ip.test.ts",
          "src/server/auth/csrf.test.ts",
          "src/server/auth/demo-paths.test.ts",
          "src/server/auth/rate-limit.test.ts",
          "src/server/auth/trusted-origins.test.ts",
          "src/server/billing/admin-view.test.ts",
          "src/server/billing/checkout.test.ts",
          "src/server/billing/ledger.test.ts",
          "src/server/billing/pause.test.ts",
          "src/server/billing/stripe.test.ts",
          "src/server/billing/summary.test.ts",
          "src/server/billing/webhooks.test.ts",
          "src/server/catalog/answer-derivations.test.ts",
          "src/server/catalog/companies-parquet.test.ts",
          "src/server/catalog/question-normalize.test.ts",
          "src/server/catalog/tag-rules.test.ts",
          "src/server/dispatch/browser/session-slots.test.ts",
          "src/server/dispatch/outcomes.test.ts",
          "src/server/dispatch/planner.test.ts",
          "src/server/dispatch/report.test.ts",
          "src/server/fixtures/sanitise.test.ts",
          "src/server/host-routing.test.ts",
          "src/server/inbox/ingest.test.ts",
          "src/server/inbox/linked-mail.test.ts",
          "src/server/inbox/mailboxes.test.ts",
          "src/server/inbox/threads.test.ts",
          "src/server/inbox/waits.test.ts",
          "src/server/lab/limit.test.ts",
          "src/server/matching/applications.test.ts",
          "src/server/pipeline/answer-plan.test.ts",
          "src/server/pipeline/approved-plan.test.ts",
          "src/server/pipeline/email-notes.test.ts",
          "src/server/pipeline/personio-form.test.ts",
          "src/server/pipeline/prepare-status.test.ts",
          "src/server/pipeline/reviews.test.ts",
          "src/server/pipeline/send-queue.test.ts",
          "src/server/platform/access/access.test.ts",
          "src/server/platform/admin-alerts.test.ts",
          "src/server/platform/alert-detail.test.ts",
          "src/server/platform/alerts.test.ts",
          "src/server/platform/audit/index.test.ts",
          "src/server/platform/crypto.test.ts",
          "src/server/platform/db/catalog-split.test.ts",
          "src/server/platform/db/hot-path-indexes.test.ts",
          "src/server/platform/db/migration-snapshot.test.ts",
          "src/server/platform/db/restore-check.test.ts",
          "src/server/platform/event-loop-lag.test.ts",
          "src/server/platform/http-body.test.ts",
          "src/server/platform/jobs/queue.test.ts",
          "src/server/platform/jobs/retention.test.ts",
          "src/server/platform/jobs/scheduler.test.ts",
          "src/server/platform/llm/anthropic-batches.test.ts",
          "src/server/platform/llm/batch-store.test.ts",
          "src/server/platform/llm/models.test.ts",
          "src/server/platform/llm/usage.test.ts",
          "src/server/platform/mail/budget.test.ts",
          "src/server/platform/mail/cloudflare.test.ts",
          "src/server/platform/outbound-guard.test.ts",
          "src/server/platform/outbound-interception.test.ts",
          "src/server/platform/ports/replica-listing.test.ts",
          "src/server/platform/rate-limit.test.ts",
          "src/server/platform/sse/hub.test.ts",
          "src/server/platform/sse/stream.test.ts",
          "src/server/profile/facts.test.ts",
          "src/server/profile/onboarding-step.test.ts",
          "src/server/profile/pdf.test.ts",
          "src/server/profile/personal-crypto.test.ts",
          "src/server/profile/resume.test.ts",
          "src/server/profile/running-state.test.ts",
          "src/server/profile/target-choices.test.ts",
          "src/server/profile/targets.test.ts",
          "src/server/profile/time-zone.test.ts",
          "src/server/profile/v1-import.test.ts",
          "src/server/routes/me.test.ts",
          "src/server/routes/ready.test.ts",
          "src/server/safe-filename.test.ts",
          "src/server/storage/database-sizes.test.ts",
          "src/server/system/report.test.ts",
          "src/shared/copy.test.ts",
          "src/shared/dossier.test.ts",
          "src/shared/host-match.test.ts",
          "src/shared/support.test.ts",
          "src/web/lib/admin-resource.test.ts",
          "src/web/lib/billing-poll.test.ts",
          "src/web/lib/live-events.test.ts"
        ]
      }
    ],
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@anthropic-ai/**"],
            "message": "Import the LLM port, not the Anthropic SDK."
          },
          {
            "group": ["@aws-sdk/**"],
            "message": "Import the mail or object-store port, not the AWS SDK."
          }
        ]
      }
    ],
    "eslint/no-restricted-exports": "error",
    "eslint/no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "eslint/no-undef": "error",
    "eslint/no-unreachable-loop": "error",
    "eslint/no-useless-assignment": "error",
    "import/export": "error",
    "import/named": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "promise/no-return-in-finally": "error",
    "unicorn/no-useless-iterator-to-array": "error",
    "typescript/no-unnecessary-condition": [
      "error",
      {
        "allowConstantLoopConditions": "only-allowed-literals",
        "checkTypePredicates": false
      }
    ],
    "typescript/prefer-optional-chain": [
      "error",
      {
        "requireNullish": true,
        "checkAny": false,
        "checkUnknown": false,
        "checkString": false,
        "checkNumber": false,
        "checkBoolean": false,
        "checkBigInt": false,
        "allowPotentiallyUnsafeFixesThatModifyTheReturnTypeIKnowWhatImDoing": false
      }
    ],
    "eslint/no-undefined": "off",
    "eslint/complexity": "off",
    "eslint/class-methods-use-this": [
      "error",
      {
        "ignoreClassesWithImplements": "public-fields",
        "ignoreOverrideMethods": true
      }
    ],
    "eslint/no-use-before-define": [
      "error",
      {
        "functions": false,
        "variables": false,
        "classes": false
      }
    ],
    "eslint/no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "eslint/no-plusplus": [
      "error",
      {
        "allowForLoopAfterthoughts": true
      }
    ],
    "unicorn/import-style": [
      "error",
      {
        "styles": {
          "path": {
            "named": true
          },
          "node:path": {
            "named": true
          }
        }
      }
    ],
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "vitest/require-test-timeout": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/non-nullable-type-assertion-style": "off",
    "typescript/explicit-member-accessibility": [
      "error",
      {
        "accessibility": "no-public"
      }
    ],
    "typescript/no-namespace": [
      "error",
      {
        "allowDeclarations": true,
        "allowDefinitionFiles": true
      }
    ],
    "typescript/no-invalid-void-type": [
      "error",
      {
        "allowAsThisParameter": true,
        "allowInGenericTypeArguments": true
      }
    ],
    "node/handle-callback-err": ["error", "^(err|error)$"],
    "node/no-process-env": [
      "error",
      {
        "allowedVariables": ["NODE_ENV"]
      }
    ],
    "node/no-top-level-await": "off",
    "import/no-relative-parent-imports": "off",
    "eslint/capitalized-comments": "off",
    "eslint/func-name-matching": "error",
    "eslint/func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true,
        "allowTypeAnnotation": true
      }
    ],
    "eslint/id-length": "off",
    "eslint/init-declarations": "off",
    "eslint/max-params": "off",
    "eslint/max-statements": "off",
    "eslint/new-cap": [
      "error",
      {
        "capIsNew": false
      }
    ],
    "eslint/no-continue": "off",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "eslint/no-magic-numbers": "off",
    "eslint/no-nested-ternary": "error",
    "eslint/no-ternary": "off",
    "eslint/one-var": ["error", "never"],
    "eslint/prefer-arrow-callback": [
      "error",
      {
        "allowNamedFunctions": true
      }
    ],
    "eslint/prefer-const": [
      "error",
      {
        "ignoreReadBeforeAssign": true
      }
    ],
    "eslint/prefer-object-spread": "error",
    "eslint/sort-imports": "off",
    "eslint/sort-keys": "off",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/no-named-export": "off",
    "import/no-namespace": "error",
    "import/no-nodejs-modules": "off",
    "import/prefer-default-export": "off",
    "node/callback-return": ["error", ["callback", "cb"]],
    "node/no-sync": "off",
    "promise/avoid-new": "off",
    "promise/prefer-await-to-callbacks": "off",
    "promise/prefer-await-to-then": "error",
    "typescript/consistent-type-definitions": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/dot-notation": [
      "error",
      {
        "allowPrivateClassPropertyAccess": true,
        "allowIndexSignaturePropertyAccess": true
      }
    ],
    "typescript/parameter-properties": [
      "error",
      {
        "prefer": "class-property"
      }
    ],
    "unicorn/catch-error-name": "error",
    "unicorn/filename-case": [
      "error",
      {
        "ignore": ["^\\$"]
      }
    ],
    "unicorn/max-nested-calls": "off",
    "unicorn/no-await-expression-member": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/no-null": "off",
    "unicorn/number-literal-case": "off",
    "unicorn/prefer-global-this": "error",
    "unicorn/prefer-reflect-apply": "off",
    "unicorn/prefer-spread": "error",
    "unicorn/prefer-ternary": "off",
    "vitest/consistent-test-it": [
      "error",
      {
        "fn": "test",
        "withinDescribe": "test"
      }
    ],
    "vitest/max-expects": "off",
    "vitest/no-duplicate-hooks": "error",
    "vitest/no-hooks": "off",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/prefer-called-once": "off",
    "vitest/prefer-called-with": "error",
    "vitest/prefer-describe-function-title": "error",
    "vitest/prefer-expect-assertions": [
      "error",
      {
        "onlyFunctionsWithExpectInCallback": true,
        "onlyFunctionsWithExpectInLoop": true
      }
    ],
    "vitest/prefer-hooks-in-order": "error",
    "vitest/prefer-import-in-mock": "error",
    "vitest/prefer-importing-vitest-globals": "error",
    "vitest/prefer-lowercase-title": [
      "error",
      {
        "ignore": ["describe"]
      }
    ],
    "vitest/prefer-mock-promise-shorthand": "error",
    "vitest/prefer-mock-return-shorthand": "error",
    "vitest/prefer-strict-boolean-matchers": "error",
    "vitest/prefer-strict-equal": "error",
    "vitest/prefer-to-be-falsy": "off",
    "vitest/prefer-to-be-truthy": "off",
    "vitest/require-hook": "off",
    "vitest/require-top-level-describe": "off",
    "oxc/no-accumulating-spread": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "oxc/no-async-endpoint-handlers": "off",
    "eslint/no-underscore-dangle": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "vitest/valid-title": [
      "error",
      {
        "ignoreTypeOfDescribeName": true
      }
    ],
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "eslint/require-await": "off",
    "import/max-dependencies": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-depth": "off",
    "eslint/max-classes-per-file": "off",
    "eslint/max-nested-callbacks": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "vitest/no-conditional-in-test": "off",
    "vitest/no-conditional-expect": "error",
    "typescript/no-confusing-void-expression": [
      "error",
      {
        "ignoreArrowShorthand": true,
        "ignoreVoidOperator": true
      }
    ],
    "unicorn/no-useless-undefined": [
      "error",
      {
        "checkArguments": false,
        "checkArrowFunctionBody": false
      }
    ],
    "typescript/return-await": ["error", "error-handling-correctness-only"],
    "typescript/prefer-nullish-coalescing": [
      "error",
      {
        "ignorePrimitives": {
          "string": true,
          "number": true,
          "boolean": true
        }
      }
    ],
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableString": true,
        "allowNullableBoolean": true,
        "allowNullableNumber": true
      }
    ],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": false
      }
    ],
    "typescript/strict-void-return": "off",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "allowDefaultCaseForExhaustiveSwitch": true,
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/forbid-component-props": "off",
    "react-perf/jsx-no-jsx-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns-type": "off",
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [".tsx"]
      }
    ],
    "react/jsx-max-depth": [
      "error",
      {
        "max": 6
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.config.{ts,mts,mjs,js}",
        "test/e2e/global-setup.ts",
        "tools/oxlint/architecture/index.ts",
        "workers/inbound-mail/src/index.ts",
        "workers/sentinel/src/index.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "src/server/config/env.ts",
        "drizzle.config.ts",
        "drizzle-catalog.config.ts",
        "test/e2e/**"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["src/server/main.ts"],
      "rules": {
        "unicorn/no-process-exit": "off"
      }
    }
  ]
}
